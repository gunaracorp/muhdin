# ================= MUHDIN — contoh konfigurasi environment =================
# Salin jadi .env lalu isi nilai asli. .env TIDAK di-commit (gitignore).

# Prisma Postgres (cloud) — wajib sejak v11.1
# Format: postgres://<USER>:<PASSWORD>@pooled.db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=

# Notifikasi email (fallback bila CMS > Notifikasi kosong) — Gmail App Password 16 karakter
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=MUHDIN — Portal Asosiasi
# NOTIFY_EMAIL_TO=

# Gateway realtime papan slot (opsional)
# MUHDIN_GATEWAY_URL=http://127.0.0.1:3004/notify
# MUHDIN_GATEWAY_SECRET=muhdin-local-gateway
# MUHDIN_NOTIFY_PORT=3004

# v12.4 «LUNAS» — Payment gateway (R-038, pola adapter)
# PAYMENT_PROVIDER: SANDBOX (default, uji tanpa uang riil) | MIDTRANS | XENDIT
# Menyambungkan gateway riil: isi provider + kredensialnya di bawah, lalu
# tambahkan adapter-nya di src/lib/payment.ts (satu file per provider).
# PAYMENT_PROVIDER=SANDBOX
# Rahasia HMAC untuk webhook /api/payments/callback (header x-muhdin-signature).
# WAJIB diisi di produksi; kosong = kunci sandbox lokal (hanya untuk uji).
# PAYMENT_WEBHOOK_SECRET=
# URL publik portal — dipakai QR di invoice PDF.
# NEXT_PUBLIC_APP_URL=https://muhdin.web.id
