generator client {
  provider      = "prisma-client-js"
  // Multi-platform: supaya Query Engine SQLite tetap jalan di shared hosting
  // CloudLinux/cPanel (rhel) maupun Debian/Ubuntu (debian).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        String    @default("ADMIN") // SUPER_ADMIN | ADMIN | EDITOR
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ==================== KONTEN ====================

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  category  String   @default("Berita")
  cover     String?
  status    String   @default("PUBLISHED")
  featured  Boolean  @default(false)
  views     Int      @default(0)
  author    String   @default("Tim MUHDIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ecosystem {
  id          String   @id @default(cuid())
  number      Int      @unique
  name        String
  cluster     String
  scope       String
  standard    String
  icon        String   @default("hexagon")
  color       String   @default("emerald")
  description String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JourneyStep {
  id       String @id @default(cuid())
  step     Int    @unique
  title    String
  activity String
  actor    String
  output   String
  icon     String @default("circle")
}

model Roadmap {
  id           String @id @default(cuid())
  phase        String
  period       String
  focus        String
  deliverables String
  order        Int    @default(0)
}

// ==================== KEANGGOTAAN ====================
model Member {
  id             String          @id @default(cuid())
  name           String
  type           String
  city           String
  province       String
  licenseNo      String
  phone          String?
  email          String?
  website        String?
  description    String?
  rating         Float           @default(4.5)
  status         String          @default("TERVERIFIKASI")
  memberSince    Int             @default(2026)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  permits        NusukPermit[]
  packages       TourPackage[]
  cards          PilgrimCard[]
  // v6.0 — ekosistem hulu-hilir
  complianceDocs ComplianceDoc[]
  seatListings   SeatListing[]   @relation("SeatOwner")
  seatTakes      SeatListing[]   @relation("SeatTaker")
  muthowifs      Muthowif[]      @relation("MuthowifAffiliation")
}

model MembershipApplication {
  id          String    @id @default(cuid())
  orgName     String
  type        String
  contactName String
  email       String
  phone       String
  city        String
  province    String
  licenseNo   String
  message     String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  ticketCode  String    @unique @default("") // kode pelacakan publik (Task 18)
  queueNumber Int?      @unique // nomor urut pendaftaran global, atomik & monoton (Task 53)
  reviewNote  String? // catatan verifikator (wajib saat menolak)
  reviewedBy  String? // nama akun verifikator yang memproses
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==================== TUTORIAL ====================

model Tutorial {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String   @default("Umum")
  level     String   @default("Pemula")
  duration  Int      @default(10)
  summary   String
  content   String
  order     Int      @default(0)
  published Boolean  @default(true)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== KOMUNIKASI ====================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("Umum")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  content   String
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==================== PROFIL ====================

model Management {
  id       String  @id @default(cuid())
  name     String
  position String
  bio      String?
  order    Int     @default(0)
}

/// Jaringan kepengurusan daerah — DPD/DPC & Branch Office (Task 19).
/// Contoh: DPD Jawa Barat + Branch Office MUHDIN JABAR Tasikmalaya.
model RegionalBranch {
  id          String   @id @default(cuid())
  name        String // "Dewan Pimpinan Daerah Jawa Barat"
  code        String   @default("") // "DPD-JABAR"
  province    String   @default("")
  city        String   @default("")
  officeName  String   @default("") // "Branch Office MUHDIN JABAR"
  address     String   @default("") // alamat lengkap kantor
  picName     String   @default("") // Person In Charge
  picPhone    String   @default("") // format bebas, tampil + wa.me link
  email       String?
  description String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ==================== NUSUK INTEGRATION ====================

model NusukConnection {
  id            String         @id @default(cuid())
  environment   String         @default("SANDBOX")
  apiKey        String         @default("")
  webhookSecret String         @default("")
  status        String         @default("DISCONNECTED")
  autoSync      Boolean        @default(true)
  totalSyncs    Int            @default(0)
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  logs          NusukSyncLog[]
}

model NusukPermit {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       String
  permitNo   String   @unique
  holderName String
  meta       String?
  status     String   @default("ACTIVE")
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  syncedAt   DateTime @default(now())
}

model NusukSyncLog {
  id              String           @id @default(cuid())
  connectionId    String?
  connection      NusukConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  type            String
  status          String
  message         String
  recordsAffected Int              @default(0)
  durationMs      Int              @default(0)
  createdAt       DateTime         @default(now())
}

// ==================== I18N — TRANSLASI KONTEN (Task 14) ====================

/// Terjemahan konten database (EN/AR). entity = nama model sumber,
/// entityKey = id/slug baris sumber, field = nama kolom yang diterjemahkan.
model ContentTranslation {
  id        String   @id @default(cuid())
  entity    String
  entityKey String
  locale    String // "en" | "ar"
  field     String
  value     String
  engine    String   @default("ai") // "ai" | "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entity, entityKey, locale, field])
  @@index([entity, locale])
  @@index([locale, entityKey])
}

// ==================== NOTIFIKASI WHATSAPP (Task 15-d) ====================

/// Konfigurasi gateway WhatsApp (baris tunggal — singleton id pertama).
/// Token tersimpan di DB lokal (bukan SiteSetting) agar tidak bocor lewat
/// GET /api/settings yang bersifat publik.
model WhatsAppSetting {
  id                String    @id @default(cuid())
  provider          String    @default("FONNTE") // FONNTE | WABLAS | CUSTOM
  apiUrl            String    @default("") // endpoint khusus untuk CUSTOM
  token             String    @default("")
  target            String    @default("") // nomor admin tujuan, format 62xxx (boleh dipisah koma untuk multi-nomor)
  enabled           Boolean   @default(false) // saklar induk notifikasi
  notifyContact     Boolean   @default(true) // pesan kontak baru
  notifyApplication Boolean   @default(true) // pendaftaran anggota baru
  lastTestAt        DateTime?
  lastTestStatus    String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ==================== NOTIFIKASI EMAIL (Task 60) ====================

/// Konfigurasi SMTP untuk notifikasi email formulir publik (singleton).
/// Default tujuan: asosiasi.muhdin@gmail.com & muhdin.indonesia@gmail.com.
/// Password = Gmail App Password (bukan password login biasa).
/// Fallback env: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS bila kolom kosong.
model EmailSetting {
  id                String    @id @default(cuid())
  smtpHost          String    @default("smtp.gmail.com")
  smtpPort          Int       @default(465)
  smtpSecure        Boolean   @default(true) // 465 = implicit TLS; 587 = STARTTLS (secure=false)
  smtpUser          String    @default("") // akun Gmail pengirim
  smtpPass          String    @default("") // App Password 16 karakter
  fromName          String    @default("MUHDIN — Portal Asosiasi")
  recipients        String    @default("asosiasi.muhdin@gmail.com,muhdin.indonesia@gmail.com") // dipisah koma
  enabled           Boolean   @default(false) // saklar induk kirim email nyata
  notifyContact     Boolean   @default(true)
  notifyApplication Boolean   @default(true)
  notifyComplaint   Boolean   @default(true)
  notifySubscriber  Boolean   @default(true)
  notifyTestimonial Boolean   @default(true)
  lastTestAt        DateTime?
  lastTestStatus    String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Audit semua upaya notifikasi (email & WhatsApp) — agar admin dapat
/// membuktikan bahwa setiap formulir benar-benar diteruskan ke sekretariat.
model NotificationLog {
  id        String   @id @default(cuid())
  channel   String // EMAIL | WHATSAPP
  eventType String // CONTACT | APPLICATION | COMPLAINT | SUBSCRIBER | TESTIMONIAL | TEST
  status    String // SENT | FAILED | SKIPPED
  recipient String   @default("") // email tujuan / nomor WA
  subject   String   @default("") // subjek email / judul event
  detail    String   @default("") // respons gateway / alasan gagal
  refId     String? // id baris formulir asal (ContactMessage, MembershipApplication, dst.)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([channel, status])
}

// ==================== KELENGKAPAN PORTAL (Task 18) ====================

/// Galeri kegiatan/dokumentasi — tampil di halaman publik #/galeri.
model Gallery {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  category  String   @default("Kegiatan") // Kegiatan | Perjalanan | Manasik | Fasilitas
  imageUrl  String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Agenda kegiatan mendatang & lampau — #/agenda.
model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime?
  category    String    @default("Kegiatan") // Kegiatan | Pelatihan | Rakernas | Safari
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Pusat unduhan — formulir, panduan, dokumen resmi. #/unduhan
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("Formulir") // Formulir | Panduan | Kebijakan | Lainnya
  fileUrl     String
  fileType    String   @default("PDF")
  published   Boolean  @default(true)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Pelanggan berlangganan kabar/newsletter (footer publik).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Pengaduan/laporan jamaah terhadap penyelenggara anggota. #/lapor
model Complaint {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  targetMember String? // nama penyelenggara yang dilaporkan (opsional)
  category     String    @default("Pelayanan") // Pelayanan | Pembayaran | Itinerary | Lainnya
  content      String
  status       String    @default("UNREAD") // UNREAD | PROCESSED | CLOSED
  responseNote String? // tindak lanjut admin
  respondedBy  String?
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Log aktivitas admin (jejak audit) — hanya Super Admin yang melihat.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("sistem")
  role      String   @default("")
  action    String // LOGIN | APPROVE | REJECT | CREATE | UPDATE | DELETE | SYNC | EXPORT | ...
  entity    String // Application | Member | Article | ...
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, action])
}

// ==================== MARKETPLACE PAKET (v5.0) ====================

/// Paket perjalanan ibadah yang ditawarkan anggota terverifikasi — #/paket.
/// Harga dalam IDR per jamaah; slot berkurang otomatis saat ada booking baru.
model TourPackage {
  id            String           @id @default(cuid())
  memberId      String
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title         String
  type          String           @default("UMROH") // UMROH | HAJI | ZIARAH | WISATA_ISLAMI
  city          String           @default("") // kota keberangkatan
  description   String
  price         Int              @default(0) // IDR per jamaah
  durationDays  Int              @default(9)
  departureDate DateTime?
  slots         Int              @default(40)
  slotsTaken    Int              @default(0)
  hotelMakkah   String           @default("")
  hotelMadinah  String           @default("")
  airline       String           @default("")
  status        String           @default("PUBLISHED") // PUBLISHED | DRAFT | CLOSED
  featured      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  bookings      PackageBooking[]
  reviews       PilgrimReview[]
  seatListings  SeatListing[]
}

/// Booking/permintaan jadwal jamaah terhadap sebuah paket (pipeline panitia).
model PackageBooking {
  id        String      @id @default(cuid())
  packageId String
  pkg       TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  pilgrims  Int         @default(1)
  note      String?
  status    String      @default("NEW") // NEW | CONTACTED | CONFIRMED | CANCELLED
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ==================== FORUM JAMAAH (v5.0) ====================

/// Diskusi antar jamaah (tanya jawab ibadah) dengan moderasi CMS — #/forum.
/// Thread baru masuk sebagai PENDING dan tampil publik setelah disetujui.
model ForumThread {
  id            String       @id @default(cuid())
  title         String
  body          String
  authorName    String
  authorContact String       @default("") // email/WA pribadi — tidak tampil publik
  category      String       @default("Umum") // Manasik | Dokumen | Perjalanan | Akomodasi | Biaya | Lainnya
  status        String       @default("PENDING") // PENDING | APPROVED | REJECTED | LOCKED
  pinned        Boolean      @default(false)
  views         Int          @default(0)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  replies       ForumReply[]
}

/// Balasan diskusi — juga melalui moderasi (PENDING → APPROVED).
model ForumReply {
  id         String      @id @default(cuid())
  threadId   String
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  status     String      @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ==================== KARTU JAMAAH DIGITAL (v5.0) ====================

/// Kartu identitas jamaah digital ber-QR — terbit via CMS, verifikasi publik #/kartu.
/// Nomor kartu dibangkitkan otomatis: MHD-JM-2026-0001 (naik berurutan).
model PilgrimCard {
  id         String      @id @default(cuid())
  cardNo     String      @unique
  fullName   String
  phone      String      @default("")
  type       String      @default("JAMAAH") // JAMAAH | PENDAMPING | PETUGAS
  memberId   String?
  member     Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  groupName  String      @default("") // nama rombongan
  status     String      @default("ACTIVE") // ACTIVE | SUSPENDED | EXPIRED
  validUntil DateTime?
  issuedBy   String      @default("")
  note       String?
  scans      Int         @default(0)
  lastScanAt DateTime?
  docs       JamaahDoc[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ==================== V6.0 — EKOSISTEM HULU-HILIR ====================
// Rantai nilai lengkap: hulu (vendor, kepatuhan, muthowif, bursa kursi)
// → proses (brankas dokumen, darurat) → hilir (ulasan terverifikasi, AI composer).

/// Jaringan vendor ekosistem — hotel, transportasi, katering, handler Saudi,
/// aviasi, TPA/asuransi, pembiayaan. Direktori lintas penyelenggara #/bisnis.
model Vendor {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("HOTEL_MAKKAH") // HOTEL_MAKKAH | HOTEL_MADINAH | TRANSPORT | CATERING | HANDLER | AVIATION | TPA | FINANCE
  city      String   @default("") // kota domisili (Makkah/Jeddah/Madinah/Jakarta…)
  country   String   @default("SA") // SA | ID | lainnya
  contact   String   @default("") // nama narahubung
  phone     String   @default("")
  email     String?
  website   String?
  services  String   @default("") // ringkasan layanan
  rating    Float    @default(0) // 0–5, dirawat CMS
  verified  Boolean  @default(false)
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Dokumen kepatuhan anggota penyelenggara (PPIU/PIHK/BPW) — SIUJK, COP, PTA,
/// SKAI, asuransi, rencana kerja. Kedaluwarsa otomatis terdeteksi (EXPIRING ≤90 hari).
model ComplianceDoc {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind      String    @default("SIUJK") // SIUJK | COP | PTA | SKAI | ASURANSI | RENCANA_KERJA | NPWP | AKTA
  docNo     String    @default("")
  issuedBy  String    @default("") // penerbit (Kemenag, dll.)
  issuedAt  DateTime?
  expiresAt DateTime?
  fileUrl   String?
  verified  Boolean   @default(false)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Bursa kursi B2B antar penyelenggara — jual (OFFER) / cari (WANTED) sisa
/// kursi rombongan. Pipeline: OPEN → RESERVED → DEAL / CLOSED.
model SeatListing {
  id            String       @id @default(cuid())
  memberId      String
  member        Member       @relation("SeatOwner", fields: [memberId], references: [id], onDelete: Cascade)
  packageId     String?
  pkg           TourPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  side          String       @default("OFFER") // OFFER (jual sisa kursi) | WANTED (mencari kursi)
  seats         Int          @default(10)
  pricePerSeat  Int          @default(0) // IDR — 0 untuk WANTED (nego)
  departureDate DateTime?
  route         String       @default("") // mis. Jakarta–Jeddah
  note          String?
  status        String       @default("OPEN") // OPEN | RESERVED | DEAL | CLOSED
  takerMemberId String? // anggota yang mengambil (RESERVED/DEAL)
  taker         Member?      @relation("SeatTaker", fields: [takerMemberId], references: [id], onDelete: SetNull)
  takerNote     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// Kolam muthowif/pembimbing ibadah — sertifikat, bahasa, spesialisasi, rating.
model Muthowif {
  id              String   @id @default(cuid())
  fullName        String
  certNo          String   @default("") // no. sertifikat muthowif (Kemenag/lembaga)
  agency          String   @default("") // lembaga penerbit / afiliasi
  languages       String   @default("ID") // CSV: ID,AR,EN
  specialties     String   @default("") // mis. Manasik Wanita, Elderly Care
  experienceYears Int      @default(1)
  phone           String   @default("")
  rating          Float    @default(0)
  availability    String   @default("AVAILABLE") // AVAILABLE | ASSIGNED | UNAVAILABLE
  memberId        String?
  member          Member?  @relation("MuthowifAffiliation", fields: [memberId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Brankas dokumen jamaah — paspor, visa, vaksin, tiket, asuransi menempel
/// pada kartu jamaah. Diajukan jamaah (PENDING) → diverifikasi CMS.
model JamaahDoc {
  id            String      @id @default(cuid())
  pilgrimCardId String
  card          PilgrimCard @relation(fields: [pilgrimCardId], references: [id], onDelete: Cascade)
  kind          String      @default("PASPOR") // PASPOR | VISA | VAKSIN | TIKET | ASURANSI | LAINNYA
  docNo         String      @default("")
  issueDate     DateTime?
  expiryDate    DateTime?
  fileUrl       String?
  verifyStatus  String      @default("PENDING") // PENDING | VERIFIED | REJECTED
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

/// Ulasan pasca-perjalanan TERVERIFIKASI — hanya pemegang kartu jamaah aktif
/// yang dapat mengulas (POST memvalidasi cardNo). Moderasi CMS.
model PilgrimReview {
  id            String      @id @default(cuid())
  packageId     String
  pkg           TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  cardNo        String      @default("") // bukti keanggotaan jamaah (tidak tampil penuh di publik)
  authorName    String
  rating        Int         @default(5) // 1–5
  hotelRate     Int         @default(5)
  transportRate Int         @default(5)
  guideRate     Int         @default(5)
  body          String
  status        String      @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

/// Direktori layanan darurat Tanah Suci & Indonesia — KJRI, KKI, rumah sakit,
/// nomor darurat Saudi (999 polisi / 997 ambulans). Publik #/darurat.
model SosPoint {
  id        String   @id @default(cuid())
  category  String   @default("HOSPITAL") // HOSPITAL | CLINIC | EMBASSY | CONSULATE | CONSUL_HAJJ | POLICE | EMERGENCY | KKI
  name      String
  city      String   @default("") // Makkah | Madinah | Jeddah | Riyadh | Jakarta…
  country   String   @default("SA") // SA | ID
  address   String   @default("")
  phone     String   @default("")
  phone2    String?
  hours     String   @default("24 jam")
  note      String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== V7.0 — PINDAI IZIN 360° ====================
// Registri perusahaan (NIB → dossier kelengkapan izin BPW/PPIU/PIHK).
// Publik memindai via #/pindai; CMS merawat registri di admin-bisnis.

/// Perusahaan pada registri pemindaian — diidentifikasi NIB unik.
model RegistryCompany {
  id          String        @id @default(cuid())
  nib         String        @unique // Nomor Induk Berusaha (OSS-RBA)
  name        String
  legalEntity String        @default("PT") // PT | CV | KOPERASI | UD | YAYASAN
  city        String        @default("")
  province    String        @default("")
  phone       String        @default("")
  website     String?
  note        String?
  docs        RegistryDoc[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Dokumen izin/sertifikasi perusahaan — satu baris per syarat katalog
/// (requirementKey = kunci katalog izin a–l, mis. PPIU, PPIU_AKREDITASI, IATA).
model RegistryDoc {
  id             String          @id @default(cuid())
  companyId      String
  company        RegistryCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requirementKey String // NIB | AKTA | NPWP | BPW | PPIU | PPIU_AKREDITASI | PIHK | PIHK_ESCROW | IATA | MUTHOWIF_SDM | ASURANSI | DIGITAL
  docNo          String          @default("")
  issuedBy       String          @default("")
  validUntil     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
